#!/usr/bin/python3 -IB
# Managed by OOM Guard (io.github.zeus-deus.oomguard).
"""Root side of OOM Guard: turn users' protected lists into earlyoom's --ignore.

Started every 15 s by oomguard-earlyoom-sync.timer, never by a user's file
event, so no user can exhaust a start limit or restart earlyoom at will. It
reads each human user's ~/.config/oomguard/protected.json, walking the path
one descriptor at a time without following symlinks and accepting only
directories and a regular file owned by that user. Each user contributes at
most rules.MAX_IGNORE_NAMES names; a broken or hostile list contributes none
and never affects anyone else's names. Names are limited to
[A-Za-z0-9._+-]{1,15} and interpreters (python3.13, bash, ...) are refused.

The result goes to /etc/oomguard/earlyoom.env. earlyoom is restarted only
when the running process does not already have exactly that --ignore, and at
most once a minute. If the administrator gave earlyoom an --ignore of their
own in /etc/default/earlyoom, OOM Guard yields: it writes an empty value and
never overrides theirs.

A list can only make earlyoom skip process names. It cannot stop earlyoom,
change thresholds or add other options.
"""
import os
import pwd
import stat
import subprocess
import sys
import time

LIB = "/usr/lib/oomguard"
sys.path.insert(0, LIB)
import rules as R  # noqa: E402

ENV_FILE = "/etc/oomguard/earlyoom.env"
ADMIN_ENV = "/etc/default/earlyoom"
STAMP = "/run/oomguard/last-restart"
MAX_BYTES = 64 * 1024
MIN_RESTART_GAP = 60
FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK


def read_list(pw):
    """The user's list, or [] for anything unexpected. Each component below
    the home directory is opened relative to its parent without following
    symlinks, and every one of them must be owned by the user."""
    fds = []
    try:
        cur = os.open(pw.pw_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        fds.append(cur)
        if os.fstat(cur).st_uid != pw.pw_uid:
            return []
        for part in (".config", "oomguard"):
            cur = os.open(part, FLAGS | os.O_DIRECTORY, dir_fd=cur)
            fds.append(cur)
            if os.fstat(cur).st_uid != pw.pw_uid:
                return []
        fd = os.open("protected.json", FLAGS, dir_fd=cur)
        fds.append(fd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != pw.pw_uid or st.st_size > MAX_BYTES:
            return []
        data = os.read(fd, MAX_BYTES + 1)
        if len(data) > MAX_BYTES:
            return []
        return R.parse_rules(data.decode("utf-8", "replace"))
    except (OSError, ValueError, RecursionError):
        return []
    finally:
        for fd in reversed(fds):
            os.close(fd)


def human_users():
    seen = set()
    for pw in pwd.getpwall():
        if 1000 <= pw.pw_uid < 60000 and pw.pw_dir.startswith("/home/") and pw.pw_uid not in seen:
            seen.add(pw.pw_uid)
            yield pw


def admin_has_ignore():
    """True when earlyoom may already get its own --ignore: from
    /etc/default/earlyoom, any other EnvironmentFile= or an Environment=
    line of its unit. Unreadable sources count as yes."""
    texts = []
    p = subprocess.run(["systemctl", "show", "-p", "Environment", "-p", "EnvironmentFiles", "earlyoom.service"],
                       capture_output=True, text=True, timeout=10, check=False)
    if p.returncode != 0:
        return True
    files = {ADMIN_ENV}
    for line in p.stdout.splitlines():
        if line.startswith("Environment="):
            texts.append(line[len("Environment="):])
        elif line.startswith("EnvironmentFiles="):
            path = line[len("EnvironmentFiles="):].split(" (", 1)[0].strip()
            if path and path != ENV_FILE:
                files.add(path)
    for path in sorted(files):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                texts.append(f.read(MAX_BYTES))
        except FileNotFoundError:
            continue
        except OSError:
            return True
    return any(R.admin_ignore(t) for t in texts)


def running_ignore():
    """(running, value of the last --ignore earlyoom was started with)."""
    p = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", "earlyoom.service"],
                       capture_output=True, text=True, timeout=10, check=False)
    pid = p.stdout.strip()
    if not pid.isdigit() or pid == "0":
        return False, ""
    try:
        with open("/proc/%s/cmdline" % pid, "rb") as f:
            args = f.read(65536).decode("utf-8", "replace").split("\0")
    except OSError:
        return False, ""
    value = ""
    for i, a in enumerate(args[:-1]):
        if a == "--ignore":
            value = args[i + 1]  # earlyoom keeps the last one it parses
    return True, value


def write_env(text):
    """Replace the env file, but only one OOM Guard wrote (marker on its first
    line). Returns False, changing nothing, for anything else at that path."""
    try:
        fd = os.open(ENV_FILE, FLAGS)
    except FileNotFoundError:
        fd = None
    except OSError:
        return False
    if fd is not None:
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return False
            old = os.read(fd, MAX_BYTES).decode("utf-8", "replace")
        finally:
            os.close(fd)
        if old == text:
            return True
        if not old.startswith(R.MARKER + "\n"):
            return False
    tmp = ENV_FILE + ".tmp"
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, ENV_FILE)
    return True


def restart_allowed():
    try:
        return time.time() - os.stat(STAMP).st_mtime >= MIN_RESTART_GAP
    except OSError:
        return True


def main():
    names = set()
    for pw in human_users():
        try:
            names.update(R.earlyoom_names(read_list(pw)))  # at most MAX_IGNORE_NAMES per user
        except Exception as exc:  # one user's list never stops the others
            print("skipped uid %d: %s" % (pw.pw_uid, type(exc).__name__), file=sys.stderr)
    yielded = admin_has_ignore()
    regex = "" if yielded else R.regex_for_names(names)
    # Every name passed R.ok_comm, so this never fires; it stays as a last
    # guard on what reaches a root unit's command line.
    if any(not (ch.isalnum() or ch in "^$()|[]._+-") for ch in regex):
        print("refusing unexpected character in regex", file=sys.stderr)
        return 1
    if not write_env(R.MARKER + "\nOOMGUARD_ARGS=%s\n" % ("--ignore " + regex if regex else "")):
        print("%s was not written by OOM Guard; leaving it alone" % ENV_FILE, file=sys.stderr)
        return 1
    running, have = running_ignore()
    # Yielding: nothing to do unless earlyoom still runs with OOM Guard's
    # list (recognisable by the session names it always contains), which as
    # the last --ignore would override the administrator's.
    stale_ours = have.startswith("^(") and set(R.SESSION_COMMS) <= R.names_in_regex(have)
    if not running or have == regex or (yielded and not stale_ours):
        return 0
    if not restart_allowed():
        return 0  # a later tick applies it
    os.makedirs(os.path.dirname(STAMP), mode=0o755, exist_ok=True)
    with open(STAMP, "w", encoding="utf-8") as f:
        f.write("%d\n" % time.time())
    if yielded:
        print("earlyoom has its own --ignore in %s; OOM Guard leaves it alone" % ADMIN_ENV)
    else:
        print("earlyoom protected process names: " + (", ".join(sorted(names)) or "none"))
    # try-restart: only if earlyoom is running; never starts a stopped one.
    # A failure fails this run, so the panel shows it instead of "linked".
    p = subprocess.run(["systemctl", "try-restart", "earlyoom.service"], check=False, timeout=30)
    if p.returncode != 0:
        print("earlyoom did not restart (exit %d)" % p.returncode, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
